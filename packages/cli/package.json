{
  "name": "typren",
  "version": "0.6.0",
  "description": "Scaffolder CLI for Typren: `typren init`, `typren apply-settings`, `typren review`.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "typren": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "check:scaffold": "node scripts/check-scaffold.mjs"
  },
  "dependencies": {
    "@typren/core": "^0.6.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typren/studio-local": "workspace:*",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typren/typren.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/typren/typren/issues"
  },
  "homepage": "https://typren.com",
  "publishConfig": {
    "access": "public"
  }
}
