{
  "name": "@typren/forms",
  "version": "0.1.0",
  "description": "Form handling for typren sites: a canonical submission model with server-authoritative validation, honeypot plus pluggable spam verification, a web-standard Request/Response handler, and pluggable delivery sinks (webhook, HubSpot, Google Sheets, JSONL file).",
  "keywords": [
    "cms",
    "typren",
    "forms",
    "webhook",
    "hubspot"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sinks": {
      "types": "./dist/sinks/index.d.ts",
      "default": "./dist/sinks/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typren/typren.git",
    "directory": "packages/forms"
  },
  "bugs": {
    "url": "https://github.com/typren/typren/issues"
  },
  "homepage": "https://typren.com"
}
