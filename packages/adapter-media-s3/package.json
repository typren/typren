{
  "name": "@typren/adapter-media-s3",
  "version": "0.2.0",
  "description": "S3-compatible media adapter for typren: one MediaAdapter over any S3 API-compatible object store (Cloudflare R2, Supabase Storage, AWS S3, MinIO). Edge-compatible, fetch + WebCrypto only, no node:fs or sharp.",
  "keywords": [
    "cms",
    "typren",
    "media",
    "s3",
    "r2",
    "supabase",
    "minio"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "peerDependencies": {
    "@typren/core": "^0.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typren/core": "workspace:*",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typren/typren.git",
    "directory": "packages/adapter-media-s3"
  },
  "bugs": {
    "url": "https://github.com/typren/typren/issues"
  },
  "homepage": "https://typren.com"
}
