{
  "name": "@typren/editor",
  "version": "0.1.0",
  "description": "Typren's editor UI: the pluggable React admin shell for pages, blocks and fields.",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typren/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.35.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typren/typren.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/typren/typren/issues"
  },
  "homepage": "https://typren.com"
}
