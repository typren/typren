{
  "name": "typren",
  "version": "0.1.0",
  "description": "Typren: a modular, markdown-based, AI-buildable site builder + pluggable editor. Monorepo root (private).",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:new": "node scripts/coverage-new-code.mjs",
    "coverage:view": "open coverage/index.html",
    "build": "bun run --filter '*' build",
    "check:scaffold": "bun run --filter typren check:scaffold",
    "api-surface:generate": "node scripts/gen-api-surface.mjs",
    "verify": "bun run build && bun run typecheck && bun run lint && bun run test:coverage && bun run coverage:new && bun run check:scaffold",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@types/react-dom": "^19.2.7",
    "next": "^16.3.4"
  }
}
