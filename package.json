{
  "name": "typren",
  "version": "0.1.0",
  "description": "Typren: a modular, markdown-based, AI-buildable site builder + pluggable editor. Monorepo root (private).",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:new": "node scripts/coverage-new-code.mjs",
    "coverage:view": "open coverage/index.html",
    "build": "bun run --filter '*' build",
    "check:scaffold": "bun run --filter typren check:scaffold",
    "check:migrations": "bun test scripts/check-migrations.test.mjs && node scripts/check-migrations.mjs",
    "test:tag-published": "bun test scripts/tag-published.test.mjs",
    "test:publish-unpublished": "bun test scripts/publish-unpublished.test.mjs",
    "api-surface:generate": "node scripts/gen-api-surface.mjs",
    "check:workflows": "bun test scripts/check-workflows.test.mjs && node scripts/check-workflows.mjs",
    "check:api-surface": "node scripts/gen-api-surface.mjs && git diff --exit-code -- etc/api-surface || (echo 'API surface snapshot is stale: run bun run api-surface:generate, commit etc/api-surface and add a changeset.' >&2; exit 1)",
    "verify": "bun run build && bun run typecheck && bun run lint && bun run test:coverage && bun run coverage:new && bun run check:scaffold && bun run check:api-surface && bun run check:workflows && bun run check:migrations && bun run test:tag-published && bun run test:publish-unpublished",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.3"
  }
}
